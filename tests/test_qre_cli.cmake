cmake_minimum_required(VERSION 3.8)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(dir "${CMAKE_CURRENT_BINARY_DIR}/qre-cli-${suffix}")
file(MAKE_DIRECTORY "${dir}")
execute_process(COMMAND "${FIXTURE_WRITER}" --write-cli-fixtures "${dir}" RESULT_VARIABLE result)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Fixture generation failed with ${result}")
endif()
file(WRITE "${dir}/malformed" "QRE")

function(snapshot out)
  file(GLOB names RELATIVE "${dir}" "${dir}/*")
  set(state "")
  foreach(name IN LISTS names)
    file(SHA256 "${dir}/${name}" hash)
    list(APPEND state "${name}=${hash}")
  endforeach()
  set(${out} "${state}" PARENT_SCOPE)
endfunction()

function(inspect code status)
  execute_process(COMMAND "${VERIFIER}" --policy policy --context context ${ARGN}
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT "${result}" STREQUAL "${code}" OR NOT stdout MATCHES "Evidence: ${status}")
    message(FATAL_ERROR "Expected ${code}/${status} for ${ARGN}, got ${result}: ${stdout} ${stderr}")
  endif()
  if(NOT stdout MATCHES "Branch: UNVALIDATED" OR NOT stdout MATCHES "Scope: supplied snapshot only")
    message(FATAL_ERROR "Missing scope or branch status for ${ARGN}: ${stdout}")
  endif()
endfunction()

snapshot(before)
inspect(2 "INSUFFICIENT" vote0 vote0 vote1)
inspect(0 "QUORUM VERIFIED" vote0 vote1 vote2)
inspect(3 "EQUIVOCATION" vote0 vote1 vote2 other)
inspect(1 "INVALID" vote0 vote1 vote2 malformed)
execute_process(COMMAND "${VERIFIER}" --policy policy --context context
  WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result STREQUAL "1" OR NOT stderr MATCHES "Usage:" OR stdout MATCHES "QUORUM VERIFIED")
  message(FATAL_ERROR "Missing bundles must return usage and exit 1: ${result} ${stdout} ${stderr}")
endif()
snapshot(after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Inspection modified the fixture directory")
endif()
file(REMOVE_RECURSE "${dir}")
